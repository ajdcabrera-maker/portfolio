---
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';
import Button from '../ds/Button.astro';
import Surface from '../ds/Surface.astro';
import Pill from '../ds/Pill.astro';
import MetricBadge from '../ds/MetricBadge.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const expertise = [
  {
    number: '01',
    title: 'AI-Native Systems Architecture',
    description:
      'Design contracts and agent workflows with DESIGN.md, Paper MCP, and Cursor. Keeping generated UI aligned to tokens and human review.',
    tags: ['DESIGN.md', 'Paper MCP', 'Cursor'],
  },
  {
    number: '02',
    title: 'Enterprise Workflow Optimization',
    description:
      'Translate dense domain logic into clear multi-role interfaces. Reducing friction across complex operational and financial systems.',
    tags: ['Domain Logic', 'Internal Tools', 'IA'],
  },
  {
    number: '03',
    title: 'Scalable Design Ops & UI Leadership',
    description:
      'Build design infrastructure that scales teams and products. Systems, governance, and data-driven UI decisions with measurable impact.',
    tags: ['Design Ops', 'Systems', 'Leadership'],
  },
];
---

<SiteLayout
  title="Aaron Cabrera, AI Systems & Product Designer"
  description="Bridging Design Ops, token governance, and code automation with DESIGN.md, Paper MCP, and Cursor workflows."
>
  <main>
    <section class="border-b border-line">
      <Container class="pb-20 pt-16 sm:pb-28 sm:pt-24">
        <Eyebrow>Portfolio</Eyebrow>

        <div
          class="mt-6 flex flex-col items-start gap-8 sm:mt-8 sm:flex-row sm:items-center"
        >
          <img
            src="/aaron-cabrera.png"
            alt="Aaron Cabrera"
            width="160"
            height="160"
            class="size-40 shrink-0 rounded-pill object-cover object-center"
          />

          <div class="flex min-w-0 flex-col gap-8">
            <div class="flex flex-col gap-2">
              <h1
                class="text-3xl font-semibold tracking-tight text-ink sm:text-5xl sm:leading-[1.1]"
              >
                Aaron Cabrera
              </h1>
              <p class="text-lg leading-relaxed text-ink-muted sm:text-xl">
                AI Systems & Product Designer
              </p>
            </div>

            <p
              class="max-w-xl text-lg leading-relaxed text-ink-muted sm:text-xl"
            >
              Bridging Design Ops, token governance, and code automation with
              <code class="code-inline">DESIGN.md</code>, Paper MCP, and Cursor
              workflows.
            </p>
          </div>
        </div>

        <div
          class="mt-10 border-t border-line pt-8 text-sm text-ink-muted"
        >
          <p>
            <span class="text-ink-subtle">Now</span>
            <span class="mx-2 text-ink-subtle">·</span>
            Senior UX/UI Designer at
            <span class="text-ink">Partners Group</span>
          </p>
        </div>
      </Container>
    </section>

    <section id="projects" class="border-b border-line">
      <Container class="py-20 sm:py-24">
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
        >
          <div>
            <Eyebrow>Selected work</Eyebrow>
            <h2
              class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
            >
              Featured projects
            </h2>
          </div>
          <Button href="/projects" variant="ghost">
            View all projects →
          </Button>
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2">
          {
            projects.map((project) => (
              <Surface
                href={`/projects/${project.slug}`}
                interactive
                class="group flex h-full flex-col bg-canvas-elevated/40 p-6 sm:p-7"
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="font-mono text-xs text-ink-subtle">
                    {String(project.data.order).padStart(2, '0')}
                  </span>
                  <span class="text-sm text-ink-subtle transition-colors group-hover:text-ink-muted">
                    →
                  </span>
                </div>

                <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink transition-colors group-hover:text-white">
                  {project.data.title}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">
                  {project.data.subtitle}
                </p>

                <div class="mt-auto pt-6">
                  {
                    project.data.metrics && project.data.metrics.length > 0 && (
                      <div class="mb-5 flex flex-wrap gap-2">
                        {project.data.metrics.map((metric) => (
                          <MetricBadge>{metric}</MetricBadge>
                        ))}
                      </div>
                    )
                  }

                  <div class="flex flex-wrap gap-2 border-t border-line-soft pt-5">
                    {project.data.stack.map((item) => (
                      <Pill>{item}</Pill>
                    ))}
                  </div>
                </div>
              </Surface>
            ))
          }
        </div>
      </Container>
    </section>

    <section class="border-b border-line">
      <Container class="py-20 sm:py-24">
        <Eyebrow>Capabilities</Eyebrow>
        <h2
          class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
        >
          Core expertise
        </h2>

        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          {
            expertise.map((pillar) => (
              <Surface
                as="article"
                class="flex h-full flex-col bg-canvas p-6 sm:p-7"
              >
                <p class="font-mono text-xs text-accent-muted">
                  {pillar.number}
                </p>
                <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">
                  {pillar.title}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">
                  {pillar.description}
                </p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {pillar.tags.map((tag) => (
                    <Pill tone="quiet">{tag}</Pill>
                  ))}
                </div>
              </Surface>
            ))
          }
        </div>
      </Container>
    </section>

    <section>
      <Container class="py-20 sm:py-24">
        <Surface
          class="bg-canvas-elevated/50 px-6 py-10 sm:flex sm:items-center sm:justify-between sm:px-10"
        >
          <div>
            <h2
              class="text-xl font-semibold tracking-tight text-ink sm:text-2xl"
            >
              Interested in connecting?
            </h2>
            <p class="mt-2 text-sm text-ink-muted">
              Let’s talk projects, Design Ops, or AI-native product systems.
            </p>
          </div>
          <Button href={site.calUrl} external size="md" class="mt-6 sm:mt-0">
            Book a call
          </Button>
        </Surface>
      </Container>
    </section>
  </main>
</SiteLayout>
