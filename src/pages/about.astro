---
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';
import Surface from '../ds/Surface.astro';
import Pill from '../ds/Pill.astro';
import Button from '../ds/Button.astro';

const principles = [
  {
    number: '01',
    title: 'Design in Code Context',
    description:
      'Know the DOM, CSS constraints, and component state before pushing pixels, so handoff matches what ships.',
  },
  {
    number: '02',
    title: 'Data Over Vibe',
    description:
      'Validate interactions with usability testing, conversion rates, and real user feedback.',
  },
  {
    number: '03',
    title: 'Strict Systems Governance',
    description:
      'Build single sources of truth so visual design and codebases stay aligned under agent-assisted work.',
  },
];

const toolkit = [
  {
    title: 'Design & Systems',
    items: [
      'Figma',
      'Storybook',
      'Zeroheight',
      'Paper.design',
      'Hotjar',
      'Miro',
    ],
  },
  {
    title: 'AI & Code',
    items: [
      'DESIGN.md',
      'Paper MCP',
      'Cursor',
      'HTML5',
      'CSS3',
      'JavaScript',
      'PHP',
      'MySQL',
      'React',
      'Tailwind',
    ],
  },
  {
    title: 'Operations',
    items: ['Jira', 'Azure DevOps', 'Asana', 'Trello'],
  },
];
---

<SiteLayout
  title="About — Aaron Cabrera"
  description="Web developer turned UX lead. Design systems, consumer platforms, enterprise workflows, and AI-native tooling."
>
  <main>
    <section class="border-b border-line">
      <Container class="pb-16 pt-16 sm:pb-24 sm:pt-24">
        <Eyebrow>About</Eyebrow>
        <h1
          class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight text-ink sm:text-5xl sm:leading-[1.1]"
        >
          Systems, code, and product design.
        </h1>

        <div
          class="mt-10 max-w-2xl space-y-6 text-base leading-relaxed text-ink-muted sm:text-lg"
        >
          <p>
            I started in web development (2015–2018) before moving into UX/UI
            design. Most recently I was Usability &amp; Design Manager at Cebu
            Pacific Air, where I built the design system from scratch and owned
            customer-facing web, mobile, and kiosk apps.
          </p>
          <p>
            At Partners Group I work on dense internal enterprise workflows and
            AI-native design systems, using
            <code class="code-inline">DESIGN.md</code>, Paper MCP, and Cursor so
            generated UI stays on contract and in human review.
          </p>
        </div>
      </Container>
    </section>

    <section class="border-b border-line">
      <Container class="py-16 sm:py-24">
        <Eyebrow>Operating philosophy</Eyebrow>
        <h2
          class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
        >
          Principles
        </h2>

        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          {
            principles.map((principle) => (
              <Surface
                as="article"
                interactive
                class="bg-canvas-elevated/50 p-6 sm:p-7"
              >
                <p class="font-mono text-xs text-accent-muted">
                  {principle.number}
                </p>
                <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">
                  {principle.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                  {principle.description}
                </p>
              </Surface>
            ))
          }
        </div>
      </Container>
    </section>

    <section class="border-b border-line">
      <Container class="py-16 sm:py-24">
        <Eyebrow>Tools</Eyebrow>
        <h2
          class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
        >
          Toolkit
        </h2>

        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          {
            toolkit.map((group) => (
              <Surface class="bg-canvas p-6 sm:p-7">
                <h3 class="text-sm font-medium text-ink-muted">{group.title}</h3>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <li>
                      <Pill>{item}</Pill>
                    </li>
                  ))}
                </ul>
              </Surface>
            ))
          }
        </div>
      </Container>
    </section>

    <section>
      <Container class="py-16 sm:py-24">
        <Surface
          class="bg-canvas-elevated/50 px-6 py-10 sm:flex sm:items-center sm:justify-between sm:px-10"
        >
          <div>
            <h2
              class="text-xl font-semibold tracking-tight text-ink sm:text-2xl"
            >
              Let’s connect
            </h2>
            <p class="mt-2 text-sm text-ink-muted">
              Open to chats about design systems, Design Ops, and product work.
            </p>
          </div>
          <Button href={site.calUrl} external size="md" class="mt-6 sm:mt-0">
            Book a call
          </Button>
        </Surface>
      </Container>
    </section>
  </main>
</SiteLayout>
