---
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';
import Surface from '../ds/Surface.astro';
import Pill from '../ds/Pill.astro';
import Button from '../ds/Button.astro';

const principles = [
  {
    number: '01',
    title: 'Code-Grounded Design',
    description:
      'Interfaces designed with system constraints, DOM structure, and token governance in mind, so design intent survives handoff and implementation.',
  },
  {
    number: '02',
    title: 'Data & Usability First',
    description:
      'Grounding decisions in usability testing, conversion metrics, and real-world impact rather than preference alone.',
  },
  {
    number: '03',
    title: 'Agentic Workflows',
    description:
      'Treating LLMs and design tools as collaborative systems built on single sources of truth (contracts, reviews, and automated alignment)',
  },
];

const toolkit = [
  {
    title: 'Design & Systems',
    items: [
      'Figma',
      'Storybook',
      'Zeroheight',
      'Paper.design',
      'Hotjar',
      'Miro',
    ],
  },
  {
    title: 'AI & Code',
    items: [
      'DESIGN.md',
      'Paper MCP',
      'Cursor',
      'HTML5',
      'CSS3',
      'JavaScript',
      'PHP',
      'MySQL',
      'React',
      'Tailwind',
    ],
  },
  {
    title: 'Operations',
    items: ['Jira', 'Azure DevOps', 'Asana', 'Trello'],
  },
];
---

<SiteLayout
  title="About — Aaron Cabrera"
  description="Designing at the intersection of systems, code, and AI — from enterprise UX leadership to AI-native design ops."
>
  <main>
    <section class="border-b border-line">
      <Container class="pb-16 pt-16 sm:pb-24 sm:pt-24">
        <Eyebrow>About</Eyebrow>
        <h1
          class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight text-ink sm:text-5xl sm:leading-[1.1]"
        >
          Designing at the Intersection of Systems, Code, and AI.
        </h1>

        <div
          class="mt-10 max-w-2xl space-y-6 text-base leading-relaxed text-ink-muted sm:text-lg"
        >
          <p>
            I’m a BS Information Technology graduate with a web development
            foundation who transitioned into end-to-end UX/UI leadership,
            bringing technical fluency into every design decision.
          </p>
          <p>
            I’ve managed high-volume consumer platforms at Cebu Pacific Air,
            driving +15% CSAT and +3% conversion, and now design enterprise
            internal software at Partners Group. Translating complex domain
            logic into clear, multi-role workflows.
          </p>
          <p>
            My current focus is pioneering AI-native workflows using
            <code class="code-inline">DESIGN.md</code>, Paper MCP, and Cursor
            to bridge design ops with automated engineering while keeping
            generated UI aligned to contracts and human review.
          </p>
        </div>
      </Container>
    </section>

    <section class="border-b border-line">
      <Container class="py-16 sm:py-24">
        <Eyebrow>Operating philosophy</Eyebrow>
        <h2
          class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
        >
          Principles
        </h2>

        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          {
            principles.map((principle) => (
              <Surface
                as="article"
                interactive
                class="bg-canvas-elevated/50 p-6 sm:p-7"
              >
                <p class="font-mono text-xs text-accent-muted">
                  {principle.number}
                </p>
                <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">
                  {principle.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                  {principle.description}
                </p>
              </Surface>
            ))
          }
        </div>
      </Container>
    </section>

    <section class="border-b border-line">
      <Container class="py-16 sm:py-24">
        <Eyebrow>Tools</Eyebrow>
        <h2
          class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
        >
          Toolkit
        </h2>

        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          {
            toolkit.map((group) => (
              <Surface class="bg-canvas p-6 sm:p-7">
                <h3 class="text-sm font-medium text-ink-muted">{group.title}</h3>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <li>
                      <Pill>{item}</Pill>
                    </li>
                  ))}
                </ul>
              </Surface>
            ))
          }
        </div>
      </Container>
    </section>

    <section>
      <Container class="py-16 sm:py-24">
        <Surface
          class="bg-canvas-elevated/50 px-6 py-10 sm:flex sm:items-center sm:justify-between sm:px-10"
        >
          <div>
            <h2
              class="text-xl font-semibold tracking-tight text-ink sm:text-2xl"
            >
              Let’s connect
            </h2>
            <p class="mt-2 text-sm text-ink-muted">
              Open to conversations about AI-native design systems, Design Ops,
              and product collaboration.
            </p>
          </div>
          <Button href={site.calUrl} external size="md" class="mt-6 sm:mt-0">
            Book a call
          </Button>
        </Surface>
      </Container>
    </section>
  </main>
</SiteLayout>
