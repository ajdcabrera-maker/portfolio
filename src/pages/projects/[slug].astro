---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: index > 0 ? projects[index - 1] : null,
      next: index < projects.length - 1 ? projects[index + 1] : null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const { title, subtitle, role, timeline, stack, metrics } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={`${title} — Aaron Cabrera`} description={subtitle}>
  <a
    href="/projects"
    class="sticky top-0 z-20 block border-b border-neutral-900/80 bg-neutral-950/80 backdrop-blur-md"
  >
    <div class="mx-auto flex max-w-3xl items-center gap-2 px-6 py-4 text-sm text-neutral-400 transition-colors hover:text-neutral-100">
      <span aria-hidden="true" class="text-neutral-500">←</span>
      <span>Back to projects</span>
    </div>
  </a>

  <article class="mx-auto max-w-3xl px-6 pb-24 pt-10">
    <header class="space-y-8">
      <div class="space-y-4">
        <p class="text-sm font-medium uppercase tracking-[0.14em] text-neutral-500">
          Case study
        </p>
        <h1 class="text-3xl font-semibold tracking-tight text-neutral-50 sm:text-4xl md:text-5xl">
          {title}
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-neutral-400">
          {subtitle}
        </p>
      </div>

      <dl class="grid gap-6 border-y border-neutral-800 py-6 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-medium uppercase tracking-[0.12em] text-neutral-500">
            Role
          </dt>
          <dd class="mt-2 text-sm text-neutral-200">{role}</dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-[0.12em] text-neutral-500">
            Timeline
          </dt>
          <dd class="mt-2 text-sm text-neutral-200">{timeline}</dd>
        </div>
      </dl>

      <div class="flex flex-wrap gap-2">
        {
          stack.map((item) => (
            <span class="rounded-full border border-neutral-800 bg-neutral-900 px-3 py-1 text-xs font-medium text-neutral-300">
              {item}
            </span>
          ))
        }
      </div>
    </header>

    {
      metrics && metrics.length > 0 && (
        <section
          aria-label="Project metrics"
          class="mt-10 grid gap-3 sm:grid-cols-2"
        >
          {metrics.map((metric) => (
            <div class="rounded-2xl border border-neutral-800 bg-neutral-100 px-5 py-6 text-neutral-950">
              <p class="text-xl font-semibold tracking-tight sm:text-2xl">
                {metric}
              </p>
            </div>
          ))}
        </section>
      )
    }

    <div class="case-study-prose mt-14">
      <Content />
    </div>

    <nav
      aria-label="Adjacent projects"
      class="mt-20 grid gap-4 border-t border-neutral-800 pt-10 sm:grid-cols-2"
    >
      {
        prev ? (
          <a
            href={`/projects/${prev.slug}`}
            class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-colors hover:border-neutral-700 hover:bg-neutral-900"
          >
            <p class="text-xs font-medium uppercase tracking-[0.12em] text-neutral-500">
              Previous
            </p>
            <p class="mt-2 text-sm font-medium text-neutral-200 transition-colors group-hover:text-neutral-50">
              ← {prev.data.title}
            </p>
          </a>
        ) : (
          <div class="hidden sm:block" />
        )
      }
      {
        next ? (
          <a
            href={`/projects/${next.slug}`}
            class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 text-right transition-colors hover:border-neutral-700 hover:bg-neutral-900 sm:col-start-2"
          >
            <p class="text-xs font-medium uppercase tracking-[0.12em] text-neutral-500">
              Next
            </p>
            <p class="mt-2 text-sm font-medium text-neutral-200 transition-colors group-hover:text-neutral-50">
              {next.data.title} →
            </p>
          </a>
        ) : null
      }
    </nav>
  </article>
</BaseLayout>
