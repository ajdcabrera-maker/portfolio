---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../ds/Eyebrow.astro';
import Pill from '../../ds/Pill.astro';
import Surface from '../../ds/Surface.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: index > 0 ? projects[index - 1] : null,
      next: index < projects.length - 1 ? projects[index + 1] : null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const { title, subtitle, role, timeline, stack, metrics } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={`${title} — Aaron Cabrera`} description={subtitle}>
  <a
    href="/projects"
    class="sticky top-0 z-20 block border-b border-line-soft bg-canvas-subtle backdrop-blur-md"
  >
    <div
      class="mx-auto flex max-w-3xl items-center gap-2 px-6 py-4 text-sm text-ink-muted transition-colors hover:text-ink"
    >
      <span aria-hidden="true" class="text-ink-subtle">←</span>
      <span>Back to projects</span>
    </div>
  </a>

  <article class="mx-auto max-w-3xl px-6 pb-24 pt-10">
    <header class="space-y-8">
      <div class="space-y-4">
        <Eyebrow>Case study</Eyebrow>
        <h1
          class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl md:text-5xl"
        >
          {title}
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-ink-muted">
          {subtitle}
        </p>
      </div>

      <dl class="grid gap-6 border-y border-line py-6 sm:grid-cols-2">
        <div>
          <dt
            class="text-xs font-medium uppercase tracking-[0.12em] text-ink-subtle"
          >
            Role
          </dt>
          <dd class="mt-2 text-sm text-ink-muted">{role}</dd>
        </div>
        <div>
          <dt
            class="text-xs font-medium uppercase tracking-[0.12em] text-ink-subtle"
          >
            Timeline
          </dt>
          <dd class="mt-2 text-sm text-ink-muted">{timeline}</dd>
        </div>
      </dl>

      <div class="flex flex-wrap gap-2">
        {
          stack.map((item) => (
            <Pill>{item}</Pill>
          ))
        }
      </div>
    </header>

    {
      metrics && metrics.length > 0 && (
        <section
          aria-label="Project metrics"
          class="mt-10 grid gap-3 sm:grid-cols-2"
        >
          {metrics.map((metric) => (
            <Surface class="border-line bg-cta px-5 py-6 text-cta-fg">
              <p class="text-xl font-semibold tracking-tight sm:text-2xl">
                {metric}
              </p>
            </Surface>
          ))}
        </section>
      )
    }

    <div class="case-study-prose mt-14">
      <Content />
    </div>

    <nav
      aria-label="Adjacent projects"
      class="mt-20 grid gap-4 border-t border-line pt-10 sm:grid-cols-2"
    >
      {
        prev ? (
          <Surface
            href={`/projects/${prev.slug}`}
            interactive
            class="group bg-canvas-elevated/40 p-5"
          >
            <p class="text-xs font-medium uppercase tracking-[0.12em] text-ink-subtle">
              Previous
            </p>
            <p class="mt-2 text-sm font-medium text-ink-muted transition-colors group-hover:text-ink">
              ← {prev.data.title}
            </p>
          </Surface>
        ) : (
          <div class="hidden sm:block" />
        )
      }
      {
        next ? (
          <Surface
            href={`/projects/${next.slug}`}
            interactive
            class="group bg-canvas-elevated/40 p-5 text-right sm:col-start-2"
          >
            <p class="text-xs font-medium uppercase tracking-[0.12em] text-ink-subtle">
              Next
            </p>
            <p class="mt-2 text-sm font-medium text-ink-muted transition-colors group-hover:text-ink">
              {next.data.title} →
            </p>
          </Surface>
        ) : null
      }
    </nav>
  </article>
</BaseLayout>
