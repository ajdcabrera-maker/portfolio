---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../ds/Container.astro';
import Eyebrow from '../../ds/Eyebrow.astro';
import Surface from '../../ds/Surface.astro';
import Pill from '../../ds/Pill.astro';
import MetricBadge from '../../ds/MetricBadge.astro';
import Button from '../../ds/Button.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<SiteLayout
  title="Selected Projects — Aaron Cabrera"
  description="A collection of work spanning AI-native design systems, generative tools, enterprise aviation platforms, and internal financial software."
>
  <main>
    <section class="border-b border-line">
      <Container class="pb-12 pt-16 sm:pb-16 sm:pt-24">
        <Eyebrow>Work</Eyebrow>
        <h1
          class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-5xl"
        >
          Selected Projects
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
          A collection of work spanning AI-native design systems, generative
          tools, enterprise aviation platforms, and internal financial software.
        </p>
      </Container>
    </section>

    <section>
      <Container class="py-12 sm:py-16">
        <div class="grid gap-4 sm:grid-cols-2">
          {
            projects.map((project) => (
              <Surface
                as="article"
                interactive
                class="flex h-full flex-col bg-canvas-elevated/50 p-6 sm:p-7"
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="font-mono text-xs text-ink-subtle">
                    {String(project.data.order).padStart(2, '0')}
                  </span>
                  <span class="text-xs text-ink-subtle">
                    {project.data.timeline}
                  </span>
                </div>

                <h2 class="mt-4 text-lg font-semibold tracking-tight text-ink">
                  {project.data.title}
                </h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">
                  {project.data.subtitle}
                </p>

                <p class="mt-5 text-sm text-ink-muted">
                  <span class="text-ink-subtle">Role</span>
                  <span class="mx-2 text-ink-subtle">·</span>
                  {project.data.role}
                </p>

                {
                  project.data.metrics && project.data.metrics.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-2">
                      {project.data.metrics.map((metric) => (
                        <MetricBadge>{metric}</MetricBadge>
                      ))}
                    </div>
                  )
                }

                <div class="mt-5 flex flex-wrap gap-2">
                  {project.data.stack.map((item) => (
                    <Pill>{item}</Pill>
                  ))}
                </div>

                <Button
                  href={`/projects/${project.slug}`}
                  variant="ghost"
                  class="mt-auto pt-8 !text-ink font-medium hover:!text-white"
                >
                  Read case study →
                </Button>
              </Surface>
            ))
          }
        </div>
      </Container>
    </section>
  </main>
</SiteLayout>
