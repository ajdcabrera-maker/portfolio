---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<SiteLayout
  title="Selected Projects — Aaron Cabrera"
  description="A collection of work spanning AI-native design systems, generative tools, enterprise aviation platforms, and internal financial software."
>
  <main>
    <section class="border-b border-neutral-900">
      <div class="mx-auto max-w-6xl px-6 pb-12 pt-16 sm:pb-16 sm:pt-24">
        <p
          class="text-sm font-medium uppercase tracking-[0.14em] text-neutral-500"
        >
          Work
        </p>
        <h1
          class="mt-4 text-3xl font-semibold tracking-tight text-neutral-50 sm:text-5xl"
        >
          Selected Projects
        </h1>
        <p
          class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-400"
        >
          A collection of work spanning AI-native design systems, generative
          tools, enterprise aviation platforms, and internal financial software.
        </p>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
        <div class="grid gap-4 sm:grid-cols-2">
          {
            projects.map((project) => (
              <article class="flex flex-col rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6 transition-colors hover:border-neutral-700 sm:p-7">
                <div class="flex items-start justify-between gap-4">
                  <span class="font-mono text-xs text-neutral-600">
                    {String(project.data.order).padStart(2, '0')}
                  </span>
                  <span class="text-xs text-neutral-500">{project.data.timeline}</span>
                </div>

                <h2 class="mt-4 text-lg font-semibold tracking-tight text-neutral-50">
                  {project.data.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-neutral-400">
                  {project.data.subtitle}
                </p>

                <p class="mt-5 text-sm text-neutral-300">
                  <span class="text-neutral-500">Role</span>
                  <span class="mx-2 text-neutral-700">·</span>
                  {project.data.role}
                </p>

                {
                  project.data.metrics && project.data.metrics.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-2">
                      {project.data.metrics.map((metric) => (
                        <span class="rounded-lg bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-950">
                          {metric}
                        </span>
                      ))}
                    </div>
                  )
                }

                <div class="mt-5 flex flex-wrap gap-2">
                  {project.data.stack.map((item) => (
                    <span class="rounded-full border border-neutral-800 bg-neutral-950/60 px-2.5 py-1 text-xs text-neutral-400">
                      {item}
                    </span>
                  ))}
                </div>

                <a
                  href={`/projects/${project.slug}`}
                  class="mt-auto pt-8 text-sm font-medium text-neutral-100 transition-colors hover:text-white"
                >
                  Read case study →
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
