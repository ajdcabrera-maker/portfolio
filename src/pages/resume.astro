---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';
import Surface from '../ds/Surface.astro';
import Button from '../ds/Button.astro';

const cvUrl = '/Aaron-Cabrera-CV.pdf';

const experience = [
  {
    role: 'Senior UX/UI Designer',
    company: 'Partners Group',
    period: 'March 2026 – Present',
    highlights: [
      'Designing enterprise internal workflow software and operational tools.',
    ],
  },
  {
    role: 'Management Consultant',
    company: 'Accenture Song',
    period: 'Nov 2025 – March 2026',
    highlights: [
      'Led end-to-end UX/interaction design work across strategy, technology, and data teams.',
    ],
  },
  {
    role: 'Usability and Design Manager',
    company: 'Cebu Pacific Air',
    period: 'Sept 2022 – Oct 2025',
    highlights: [
      'Spearheaded UX/UI across web, mobile, and chatbot platforms.',
      'Boosted CSAT by 15% and conversion by 3%.',
      'Established Figma to Storybook/Zeroheight design ops.',
    ],
  },
  {
    role: 'UI/UX Lead',
    company: 'Makatisoft, Inc.',
    period: 'Nov 2018 – Aug 2022',
    highlights: [
      'Owned design direction for crypto wallet (Swapoo) and mental healthcare/learning platforms.',
    ],
  },
  {
    role: 'Web Designer & Developer',
    company: 'Strategic Marketing & Exhibitions, Dubai',
    period: 'Aug 2015 – Nov 2018',
    highlights: [
      'Sole designer/developer building end-to-end event websites using HTML, CSS, JS, PHP, MySQL.',
    ],
  },
];

const education = {
  degree: 'BS Information Technology',
  school: 'Jose Rizal University',
  period: '2011 – 2015',
};
---

<SiteLayout
  title="Resume — Aaron Cabrera"
  description="Experience timeline spanning enterprise UX, aviation platforms, product design leadership, and full-stack web development."
>
  <main>
    <section class="border-b border-line">
      <Container
        class="flex flex-col gap-8 pb-12 pt-16 sm:flex-row sm:items-end sm:justify-between sm:pb-16 sm:pt-24"
      >
        <div>
          <Eyebrow>CV</Eyebrow>
          <h1
            class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-5xl"
          >
            Resume / Experience
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-muted">
            A scannable overview of roles across AI-native systems, enterprise
            workflows, aviation platforms, and product design leadership.
          </p>
        </div>

        <Button href={cvUrl} download size="md" class="shrink-0">
          Download PDF CV
        </Button>
      </Container>
    </section>

    <section class="border-b border-line">
      <Container class="py-16 sm:py-20">
        <Eyebrow>Experience</Eyebrow>

        <ol
          class="relative ml-2 mt-10 space-y-0 border-l border-line sm:ml-3"
        >
          {
            experience.map((job) => (
              <li class="relative pb-12 pl-8 last:pb-0 sm:pl-10">
                <span
                  class="absolute -left-[5px] top-1.5 size-2.5 rounded-full border border-ink-subtle bg-canvas"
                  aria-hidden="true"
                />

                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <div>
                    <h3 class="text-lg font-semibold tracking-tight text-ink">
                      {job.role}
                    </h3>
                    <p class="mt-1 text-sm text-ink-muted">{job.company}</p>
                  </div>
                  <time class="shrink-0 font-mono text-xs text-ink-subtle sm:text-right">
                    {job.period}
                  </time>
                </div>

                <ul class="mt-4 space-y-2">
                  {job.highlights.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-ink-muted">
                      <span
                        class="mt-2 size-1 shrink-0 rounded-full bg-ink-subtle"
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </Container>
    </section>

    <section>
      <Container class="py-16 sm:py-20">
        <Eyebrow>Education</Eyebrow>

        <Surface
          class="mt-10 bg-canvas-elevated/50 p-6 sm:flex sm:items-baseline sm:justify-between sm:p-7"
        >
          <div>
            <h3 class="text-lg font-semibold tracking-tight text-ink">
              {education.degree}
            </h3>
            <p class="mt-1 text-sm text-ink-muted">{education.school}</p>
          </div>
          <time class="mt-3 block font-mono text-xs text-ink-subtle sm:mt-0">
            {education.period}
          </time>
        </Surface>
      </Container>
    </section>
  </main>
</SiteLayout>
