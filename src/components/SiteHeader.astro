---
const calUrl = 'https://cal.com/aaron-cabrera-27ln1w';
const pathname = Astro.url.pathname;

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-30 border-b border-neutral-900/80 bg-neutral-950/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-6 py-4"
  >
    <a
      href="/"
      class:list={[
        'min-w-0 truncate text-sm font-medium tracking-tight transition-colors hover:text-white',
        pathname === '/' ? 'text-white' : 'text-neutral-100',
      ]}
    >
      Aaron Cabrera
    </a>

    <div class="flex shrink-0 items-center gap-2">
      <!-- Desktop nav links -->
      <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
        {
          links.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-1.5 text-sm transition-colors',
                  active
                    ? 'bg-neutral-900 text-neutral-50'
                    : 'text-neutral-400 hover:bg-neutral-900 hover:text-neutral-100',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Primary CTA — always visible -->
      <a
        href={calUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-neutral-100 bg-neutral-100 px-3.5 py-1.5 text-sm font-medium text-neutral-950 transition-colors hover:bg-white"
      >
        Book a call
      </a>

      <!-- Mobile menu toggle (no JS) -->
      <details class="group relative md:hidden">
        <summary
          class="flex size-9 list-none cursor-pointer items-center justify-center rounded-lg border border-neutral-800 text-neutral-300 transition-colors hover:border-neutral-700 hover:bg-neutral-900 hover:text-neutral-50 [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <span class="sr-only">Menu</span>
          <!-- hamburger -->
          <svg
            class="size-4 group-open:hidden"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
          </svg>
          <!-- close -->
          <svg
            class="hidden size-4 group-open:block"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 4l8 8M12 4l-8 8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
          </svg>
        </summary>

        <nav
          aria-label="Mobile"
          class="absolute right-0 top-[calc(100%+0.5rem)] w-48 overflow-hidden rounded-xl border border-neutral-800 bg-neutral-950 py-1 shadow-xl shadow-black/40"
        >
          {
            links.map((link) => {
              const active = isActive(link.href);
              return (
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block px-4 py-2.5 text-sm transition-colors',
                    active
                      ? 'bg-neutral-900 text-neutral-50'
                      : 'text-neutral-400 hover:bg-neutral-900 hover:text-neutral-100',
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
        </nav>
      </details>
    </div>
  </div>
</header>
