---
const calUrl = 'https://cal.com/aaron-cabrera-27ln1w';
const pathname = Astro.url.pathname;

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-30 border-b border-neutral-900/80 bg-neutral-950/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4"
  >
    <a
      href="/"
      class:list={[
        'text-sm font-medium tracking-tight transition-colors hover:text-white',
        pathname === '/' ? 'text-white' : 'text-neutral-100',
      ]}
    >
      Aaron Cabrera
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-lg px-2.5 py-1.5 text-sm transition-colors sm:px-3',
                active
                  ? 'bg-neutral-900 text-neutral-50'
                  : 'text-neutral-400 hover:bg-neutral-900 hover:text-neutral-100',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href={calUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 rounded-full border border-neutral-100 bg-neutral-100 px-3.5 py-1.5 text-sm font-medium text-neutral-950 transition-colors hover:bg-white sm:ml-2"
      >
        Book a call
      </a>
    </nav>
  </div>
</header>
