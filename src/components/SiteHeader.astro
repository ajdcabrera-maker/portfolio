---
import { site } from '../lib/site';
import Container from '../ds/Container.astro';
import Button from '../ds/Button.astro';

const pathname = Astro.url.pathname;
const links = site.nav;

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-30 border-b border-line-soft bg-canvas-subtle backdrop-blur-md"
>
  <Container
    class="flex items-center justify-between gap-3 py-4"
  >
    <a
      href="/"
      class:list={[
        'min-w-0 truncate text-sm font-medium tracking-tight transition-colors hover:text-white',
        pathname === '/' ? 'text-white' : 'text-ink',
      ]}
    >
      {site.name}
    </a>

    <div class="flex shrink-0 items-center gap-2">
      <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
        {
          links.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'rounded-control px-3 py-1.5 text-sm transition-colors',
                  active
                    ? 'bg-canvas-elevated text-ink'
                    : 'text-ink-muted hover:bg-canvas-elevated hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <Button href={site.calUrl} external>
        Book a call
      </Button>

      <details class="group relative md:hidden">
        <summary
          class="flex size-9 list-none cursor-pointer items-center justify-center rounded-control border border-line text-ink-muted transition-colors hover:border-line-strong hover:bg-canvas-elevated hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <span class="sr-only">Menu</span>
          <svg
            class="size-4 group-open:hidden"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
          </svg>
          <svg
            class="hidden size-4 group-open:block"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 4l8 8M12 4l-8 8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
          </svg>
        </summary>

        <nav
          aria-label="Mobile"
          class="absolute right-0 top-[calc(100%+0.5rem)] w-48 overflow-hidden rounded-card border border-line bg-canvas py-1 shadow-xl shadow-black/40"
        >
          {
            links.map((link) => {
              const active = isActive(link.href);
              return (
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block px-4 py-2.5 text-sm transition-colors',
                    active
                      ? 'bg-canvas-elevated text-ink'
                      : 'text-ink-muted hover:bg-canvas-elevated hover:text-ink',
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
        </nav>
      </details>
    </div>
  </Container>
</header>
